<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF5B2BD6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="36dp"
        android:paddingEnd="56dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">
            <TextView android:id="@+id/greeting" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#FFFFFFFF" android:textSize="46sp" />
            <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="28sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/classicRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/weatherCard" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/card_bg" android:orientation="vertical"
                android:paddingStart="26dp" android:paddingTop="22dp" android:paddingEnd="26dp" android:paddingBottom="22dp">
                <TextView android:id="@+id/weatherTitle" style="@style/SectionTitle" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/weatherNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="46sp" />
                    <TextView android:id="@+id/weatherLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="28sp" />
                    <TextView android:id="@+id/weatherDetailWide" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="48dp" android:lineSpacingExtra="4dp" android:textColor="#CCFFFFFF"
                        android:textSize="23sp" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/weatherDetail" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" android:textColor="#CCFFFFFF" android:textSize="23sp" />
                <LinearLayout android:id="@+id/hours" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout android:id="@+id/calendarCard" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="24dp" android:layout_weight="1.2" android:background="@drawable/card_bg"
                android:orientation="vertical" android:paddingStart="26dp" android:paddingTop="18dp"
                android:paddingEnd="26dp" android:paddingBottom="18dp">
                <LinearLayout android:id="@+id/calHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:id="@+id/calWeekday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:letterSpacing="0.06" android:textColor="#CCFFFFFF" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/calDay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="44sp" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/chips" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:gravity="end" android:orientation="horizontal" />
                </LinearLayout>
                <io.github.morningtv.ui.TimelineView android:id="@+id/timeline" android:layout_width="match_parent"
                    android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" />
                <LinearLayout android:id="@+id/agendaList" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/graphCard" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_marginTop="22dp" android:layout_weight="1" android:background="@drawable/card_bg"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="20dp"
            android:paddingEnd="24dp" android:paddingBottom="16dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/gNow" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:singleLine="true" android:textColor="#FFFFFFFF" android:textSize="36sp" />
                <TextView android:id="@+id/gLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="18sp" />
                <TextView android:id="@+id/gDetail" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="28dp" android:layout_weight="1" android:lineSpacingExtra="2dp"
                    android:textColor="#CCFFFFFF" android:textSize="14sp" />
                <LinearLayout android:id="@+id/gChips" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>
            <io.github.morningtv.ui.TimeGraphView android:id="@+id/graph" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout android:id="@+id/pill" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@drawable/pill_bg" android:gravity="center_vertical"
            android:orientation="horizontal" android:paddingStart="24dp" android:paddingTop="14dp"
            android:paddingEnd="24dp" android:paddingBottom="14dp" android:visibility="gone">
            <ImageView android:id="@+id/pillIcon" android:layout_width="26dp" android:layout_height="26dp" />
            <TextView android:id="@+id/pillTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/pillTitle" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:layout_weight="1" android:ellipsize="end" android:singleLine="true"
                android:textColor="#FFFFFFFF" android:textSize="24sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="16dp" android:layout_marginTop="8dp" android:orientation="horizontal">
            <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:drawablePadding="6dp" android:gravity="center_vertical"
                android:textColor="#B3FFFFFF" android:textSize="12sp" />
            <TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
